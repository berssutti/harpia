# Copy to .env and replace every value with a strong random secret.
# Generate one with: openssl rand -hex 32

# Shared secret between the API, the Nuxt proxy and the worker.
HARPIA_API_KEY=change-me-64-hex-chars

# Password for the internal Redis instance.
REDIS_PASSWORD=change-me-64-hex-chars

# HTTP Basic credentials required by the dashboard (the data proxy).
HARPIA_UI_USER=admin
HARPIA_UI_PASSWORD=change-me-strong-password

# Interface used to publish ports 3000 and 8000. Keep 127.0.0.1 unless a TLS
# reverse proxy sits in front of the app.
HARPIA_BIND_ADDR=127.0.0.1

# Optional comma-separated list of extra browser origins allowed by the API.
# Leave empty when the dashboard reaches the API through the Nuxt proxy.
HARPIA_CORS_ORIGINS=
